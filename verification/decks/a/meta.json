   "cols": "f, s21_db, f, s11_db",
   "gives": [
    "msb_gain",
    "bw_msb",
    "s11_msb",
    "s11",
    "s11_edge_ghz",
    "weight",
    "bw"
   ]
  },
  "s22": {
   "out": "s22.csv",
   "cols": "f, s22_db",
   "gives": [
    "s22",
    "s22_edge_ghz"
   ]
  },
  "balance": {
   "out": "balance.csv",
